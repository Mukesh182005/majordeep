# ─── Deepfake Detection Platform — environment template ──────────────────────
# Copy this file to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_NAME="Deepfake Detection Platform"
API_V1_PREFIX=/api
ENVIRONMENT=development        # development | production
DEBUG=true

# Auth
# Generate a secure key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is SQLite (no setup needed). For PostgreSQL (e.g. docker-compose):
# DATABASE_URL=postgresql+psycopg://deepfake:change-me-too@db:5432/deepfake
DATABASE_URL=sqlite:///./storage/deepfake.db

# Queue (Celery + Redis)
# Leave empty to run inference inline without Redis.
# For docker-compose: redis://redis:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Storage
STORAGE_DIR=./storage/uploads
EVIDENCE_DIR=./storage/evidence
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=100

# Rate limits
UPLOAD_RATE_LIMIT_PER_HOUR=20
GUEST_RATE_LIMIT_PER_HOUR=3
# Reverse proxies (IPs or CIDRs) allowed to set X-Real-IP; empty = trust none.
# docker-compose sets the frontend nginx's fixed address (172.28.0.10).
TRUSTED_PROXIES=

# Public-upload limits and retention
ENABLED_MEDIA_TYPES=image,audio,video  # e.g. "image" for an image-only beta
MAX_AUDIO_SECONDS=600
MAX_VIDEO_SECONDS=300
RETENTION_HOURS=72                     # guest jobs and their files are deleted after this

# Login cookie (httpOnly, SameSite=Lax). Secure by default only in production;
# set AUTH_COOKIE_SECURE=true/false to override.
# AUTH_COOKIE_SECURE=true
SIGNED_URL_TTL_SECONDS=300             # lifetime of signed report/WebSocket links

# Models
CHECKPOINT_DIR=./checkpoints
IMAGE_MODEL_BACKBONE=efficientnet_b4   # efficientnet_b0 | efficientnet_b4 | xception
IMAGE_MODEL_VERSION=image-detector-v1.0.0
AUDIO_MODEL_VERSION=audio-lcnn-v1.0.0
VIDEO_MODEL_VERSION=video-frame-agg-v1.0.0
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_FRAMES=32
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_SECONDS=4.0
DEVICE=cpu                             # cpu | cuda
# Audio: lcnn_asvspoof (ASVspoof 2019 LA LCNN decides the verdict) | legacy
# (hand-set rules, no trained model, results marked experimental)
AUDIO_MODEL_SOURCE=lcnn_asvspoof
# AUDIO_LCNN_CALIBRATION_FILE=./paper/config/audio_calibration.json
# AUDIO_VERDICT_CONFIG_FILE=./paper/config/frozen_audio_config.json
# pellav2 (pretrained, MIT) decides the audio verdict; the LCNN is the fallback and context.
AUDIO_PELLAV2_ENABLED=true
AUDIO_PELLAV2_IN_VERDICT=true
AUDIO_PELLAV2_MAX_WINDOWS=8              # 8 x 4 s = the first 32 s

# Image scene detectors (docs/models/MODEL_CARD.md). The fine-tuned checkpoint folder is not in
# git; without it the original Community Forensics model runs alone.
COMMFOR_ENABLED=true
COMMFOR_WEIGHT=4
COMMFOR_FT_CHECKPOINT=commfor_ft_v3/model.safetensors
COMMFOR_FT_WEIGHT=4
IMAGE_AUTHENTIC_MAX_PROB_WITHOUT_CAMERA=0.02
# TruFor edit localisation: shown, not in the verdict. Nonprofit use only (its licence).
TRUFOR_ENABLED=true
TRUFOR_IN_VERDICT=false

# Video face-swap detector GenD (pretrained, MIT); decides the face part of video verdicts
# (measured: evaluation/VIDEO-GEND-01).
GEND_ENABLED=true
GEND_MODEL_ID=yermandy/GenD_CLIP_L_14
GEND_IN_VERDICT=true
VIDEO_SCENE_FRAMES=8                     # frames scored by the scene AI detectors per video
# AI-generated video detector (runs when checkpoints/aivideo_clip/head.json exists). Off in the verdict:
# true catches 40/40 Veo 3 clips but flags 2/40 real DFD clips (evaluation/AIVIDEO-01).
AIVIDEO_IN_VERDICT=false

# Decision thresholds
FAKE_THRESHOLD=0.5
UNCERTAIN_BAND=0.15

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
