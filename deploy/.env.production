# Storage Paths
STORAGE_DIR=/app/storage/uploads
EVIDENCE_DIR=/app/storage/evidence
REPORT_DIR=/app/storage/reports
CHECKPOINT_DIR=/app/checkpoints
HF_HOME=/app/.cache/huggingface

# Model Configuration
FACE_MODEL_IN_VERDICT=false
