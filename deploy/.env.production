MAX_AUDIO_SECONDS=0

# Rate Limiting & Privacy Retention
UPLOAD_RATE_LIMIT_PER_HOUR=20
GUEST_RATE_LIMIT_PER_HOUR=3
RETENTION_HOURS=72

# Network Security
# Trusted proxy IP for X-Real-IP forwarding (frontend container fixed IP and localhost)
