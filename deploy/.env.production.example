# DeepSentinel Production Environment Template (.env.production.example)
# Copy to .env or deploy/.env.production before starting the stack:
#   cp deploy/.env.production.example .env

ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=replace_with_random_48_byte_hex_secret

# Database Configuration
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=deepfake
DATABASE_URL=postgresql+psycopg://deepfake:replace_with_strong_password@db:5432/deepfake

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Domain & CORS Configuration
CORS_ORIGINS=https://beta.deepsentinel.ai,http://localhost:8080

# Image-Only Beta Constraints
ENABLED_MEDIA_TYPES=image
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=0
MAX_AUDIO_SECONDS=0

# Rate Limiting & Privacy Retention
UPLOAD_RATE_LIMIT_PER_HOUR=20
GUEST_RATE_LIMIT_PER_HOUR=3
RETENTION_HOURS=72

# Network Security
TRUSTED_PROXIES=172.28.0.10,127.0.0.1

# Storage & Hugging Face Cache
STORAGE_DIR=/app/storage/uploads
EVIDENCE_DIR=/app/storage/evidence
REPORT_DIR=/app/storage/reports
CHECKPOINT_DIR=/app/checkpoints
HF_HOME=/app/.cache/huggingface

# Model Settings
FACE_MODEL_IN_VERDICT=false
